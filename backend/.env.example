# ============================================================================
# PME System — backend environment contract
# ============================================================================
# This file is COMMITTED and is the documented contract. It carries
# placeholders only, deliberately (D3) — a file under version control is a
# permanent record, and a password pasted into it cannot be un-leaked by a
# later `git rm`.
#
# To create your local environment:
#   copy .env.example .env    and replace every `change-me`.
#
# `backend/.env` is git-ignored and is the ONLY file that holds real secrets.
# The server refuses to start while any `change-me` remains, so a forgotten
# edit is a loud startup failure rather than a forgeable JWT.
# ============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (MySQL 8.0.34, Windows service `MySQL80`) ---
# Use the literal 127.0.0.1, NOT `localhost`: on some Windows configurations
# `localhost` makes Node attempt an IPv6 connection first while the MySQL user
# table may only carry the `127.0.0.1` row, which surfaces as an unexplained
# ECONNREFUSED. The explicit IPv4 literal is unambiguous.
DB_HOST=127.0.0.1
DB_PORT=3306
# Never `root`. The app is scoped to pme_system.* only (D2).
DB_USER=pme_user
# Set to the password chosen in database/bootstrap.sql
DB_PASSWORD=change-me
DB_NAME=pme_system

# --- Auth (used from Phase 1) ---
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=14d

# --- Uploads (used from Phase 2) ---
UPLOAD_DIR=uploads/letters
MAX_UPLOAD_SIZE_MB=10
